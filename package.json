{
  "name": "stripe-payment-sync",
  "version": "1.0.0",
  "description": "A durable Stripe sandbox to PostgreSQL and CRM sync reference with crash recovery and reconciliation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "mock-crm": "ts-node src/mock-crm/server.ts",
    "simulate-webhook": "ts-node src/scripts/simulate-webhook.ts",
    "demo": "ts-node src/scripts/demo.ts",
    "test:unit": "jest --runInBand tests/crm.test.ts tests/source.test.ts",
    "test:integration": "jest --runInBand tests/sync.integration.test.ts"
  },
  "keywords": [
    "stripe",
    "payments",
    "automation",
    "crm"
  ],
  "author": "Volodymyr",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "stripe": "^14.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "prisma": "^5.8.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
